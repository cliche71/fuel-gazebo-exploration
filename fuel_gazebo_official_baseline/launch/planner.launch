<launch>
  <!-- A fresh upstream FUEL tree is built separately. No simulator.xml/SO3
       simulator and no old exploration/navigation launch is included here. -->
  <arg name="rviz" default="true"/>
  <arg name="odom_topic" default="/hummingbird/odometry_sensor1/odometry"/>
  <arg name="command_topic" default="/hummingbird/command/trajectory"/>
  <arg name="camera_info_topic" default="/hummingbird/vi_sensor/camera_depth/depth/camera_info"/>
  <arg name="depth_topic" default="/hummingbird/vi_sensor/camera_depth/depth/disparity"/>
  <arg name="init_x" default="0.0"/>
  <arg name="init_y" default="0.0"/>
  <arg name="init_z" default="1.0"/>

  <group ns="fuel_official">
    <node pkg="fuel_gazebo_official_baseline" type="sensor_bridge.py" name="sensor_bridge" required="true" output="screen">
      <param name="odom_topic" value="$(arg odom_topic)"/>
      <param name="depth_topic" value="$(arg depth_topic)"/>
      <param name="camera_info_topic" value="$(arg camera_info_topic)"/>
    </node>

    <!-- wait_ready preserves the launched command and node name. It waits for
         fresh camera/odometry pairing and calibration before exec'ing FUEL. -->
    <node pkg="exploration_manager" type="exploration_node" name="planner" required="true" output="screen"
          launch-prefix="$(find fuel_gazebo_official_baseline)/scripts/wait_ready.py">
      <rosparam command="load" file="$(find fuel_gazebo_official_baseline)/config/planner.yaml"/>
      <param name="exploration/tsp_dir" value="$(env HOME)/.ros/fuel_official_baseline/tsp"/>
      <remap from="/odom_world" to="odom_world"/>
      <remap from="/waypoint_generator/waypoints" to="trigger"/>
      <remap from="/map_ros/pose" to="sensor_pose"/>
      <remap from="/map_ros/depth" to="depth"/>
      <remap from="/map_ros/cloud" to="unused_cloud"/>
      <remap from="/planning/replan" to="planning/replan"/>
      <remap from="/planning/new" to="planning/new"/>
      <remap from="/planning/bspline" to="planning/bspline"/>
      <remap from="/planning_vis/trajectory" to="planning_vis/trajectory"/>
      <remap from="/planning_vis/topo_path" to="planning_vis/topo_path"/>
      <remap from="/planning_vis/prediction" to="planning_vis/prediction"/>
      <remap from="/planning_vis/visib_constraint" to="planning_vis/visib_constraint"/>
      <remap from="/planning_vis/frontier" to="planning_vis/frontier"/>
      <remap from="/planning_vis/yaw" to="planning_vis/yaw"/>
      <remap from="/planning_vis/viewpoints" to="planning_vis/viewpoints"/>
      <remap from="/sdf_map/occupancy_all" to="map/occupancy_all"/>
      <remap from="/sdf_map/occupancy_local" to="map/occupancy_local"/>
      <remap from="/sdf_map/occupancy_local_inflate" to="map/occupancy_inflate"/>
      <remap from="/sdf_map/depth_cloud" to="map/depth_cloud"/>
      <remap from="/sdf_map/unknown" to="map/unknown"/>
      <remap from="/sdf_map/esdf" to="map/esdf"/>
      <remap from="/sdf_map/update_range" to="map/update_range"/>
    </node>

    <node pkg="plan_manage" type="traj_server" name="traj_server" required="true" output="screen"
          launch-prefix="$(find fuel_gazebo_official_baseline)/scripts/wait_ready.py">
      <remap from="/position_cmd" to="position_cmd"/>
      <remap from="/odom_world" to="odom_world"/>
      <param name="traj_server/external_initialization" value="true"/>
      <param name="traj_server/pub_traj_id" value="4"/>
      <param name="traj_server/init_x" value="$(arg init_x)"/>
      <param name="traj_server/init_y" value="$(arg init_y)"/>
      <param name="traj_server/init_z" value="$(arg init_z)"/>
      <!-- Matches the official FSM's .200-second replan lookahead. -->
      <param name="fsm/replan_time" value="0.2"/>
      <param name="loop_correction/isLoopCorrection" value="false"/>
      <param name="perception_utils/top_angle" value="0.56125"/>
      <param name="perception_utils/left_angle" value="0.69222"/>
      <param name="perception_utils/right_angle" value="0.68901"/>
      <param name="perception_utils/max_dist" value="4.5"/>
      <param name="perception_utils/vis_dist" value="1.0"/>
    </node>

    <node pkg="fuel_gazebo_official_baseline" type="command_bridge.py" name="command_bridge" required="true" output="screen">
      <param name="odom_topic" value="$(arg odom_topic)"/>
      <param name="command_topic" value="$(arg command_topic)"/>
      <param name="init_x" value="$(arg init_x)"/>
      <param name="init_y" value="$(arg init_y)"/>
      <param name="init_z" value="$(arg init_z)"/>
    </node>
    <node if="$(arg rviz)" pkg="rviz" type="rviz" name="view" output="screen"
          args="-d $(find fuel_gazebo_official_baseline)/config/official.rviz"/>
  </group>
</launch>
