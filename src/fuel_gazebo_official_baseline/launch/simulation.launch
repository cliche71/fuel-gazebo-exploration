<launch>
  <!-- Separate simulation: close the previous Gazebo launch before starting. -->
  <arg name="robot_file" default="$(env HOME)/.ros/fuel_gazebo/robot.urdf"/>
  <arg name="world_file" default="$(find fuel_gazebo_official_baseline)/worlds/office_rotors.world"/>
  <env name="GAZEBO_PLUGIN_PATH" value="$(find fuel_camera_adapter)/../../devel/lib:$(optenv GAZEBO_PLUGIN_PATH)"/>
  <arg name="gui" default="true"/>
  <!-- False is reserved for a paused packaging check; normal startup unchanged. -->
  <arg name="start_hover" default="true"/>
  <arg name="seed" default="20261029"/>
  <env name="GAZEBO_MODEL_PATH" value="$(find fuel_gazebo_official_world)/models:$(find rotors_gazebo)/models:$(optenv GAZEBO_MODEL_PATH)"/>
  <env name="GAZEBO_RESOURCE_PATH" value="$(find rotors_gazebo)/models:$(optenv GAZEBO_RESOURCE_PATH)"/>
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(arg world_file)"/>
    <arg name="paused" value="true"/>
    <arg name="extra_gazebo_args" value="--seed $(arg seed)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="use_sim_time" value="true"/>
  </include>
  <group ns="hummingbird">
    <param name="robot_description" textfile="$(arg robot_file)"/>
    <param name="tf_prefix" value="" type="str"/>
    <node name="spawn_hummingbird" pkg="gazebo_ros" type="spawn_model"
          args="-param robot_description -urdf -x 0 -y 0 -z 0.1 -model hummingbird"
          output="screen"/>
    <node name="lee_position_controller_node" pkg="rotors_control"
          type="lee_position_controller_node" output="screen" required="true">
      <rosparam command="load" file="$(find rotors_gazebo)/resource/lee_controller_hummingbird.yaml"/>
      <rosparam command="load" file="$(find rotors_gazebo)/resource/hummingbird.yaml"/>
      <rosparam command="load" file="$(find fuel_gazebo_official_baseline)/config/hummingbird_vi_control.yaml"/>
      <remap from="odometry" to="odometry_sensor1/odometry"/>
    </node>
    <node if="$(arg start_hover)" name="hovering_example" pkg="rotors_gazebo" type="hovering_example" output="screen">
      <param name="x" value="0.0"/>
      <param name="y" value="0.0"/>
      <param name="z" value="1.0"/>
      <param name="yaw" value="0.0"/>
    </node>
    <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher"/>
    <node name="joint_state_publisher" pkg="joint_state_publisher" type="joint_state_publisher"/>
  </group>
</launch>
