<?xml version="1.0"?>
<package format="2">
  <name>fuel_gazebo_official_world</name>
  <version>0.1.0</version>
  <description>Official FUEL office scene converted into Gazebo Classic static collision boxes.</description>
  <maintainer email="local@example.invalid">FUEL Gazebo local integration</maintainer>
  <license>GPL-3.0</license>
  <buildtool_depend>catkin</buildtool_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_msgs</exec_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>rosnode</exec_depend>
  <exec_depend>rospkg</exec_depend>
  <exec_depend>rosgraph</exec_depend>
  <exec_depend>genpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <export><gazebo_ros gazebo_model_path="${prefix}/models"/></export>
</package>
