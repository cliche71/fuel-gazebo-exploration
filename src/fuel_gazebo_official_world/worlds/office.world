<?xml version="1.0"?>
<sdf version="1.6">
  <world name="fuel_official_office_preview">
    <gravity>0 0 -9.8</gravity>
    <physics type="ode">
      <max_step_size>0.01</max_step_size>
      <real_time_update_rate>100</real_time_update_rate>
    </physics>
    <scene><ambient>0.5 0.5 0.5 1</ambient><background>0.7 0.75 0.8 1</background><shadows>true</shadows></scene>
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows><pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse><specular>0.2 0.2 0.2 1</specular>
      <attenuation><range>1000</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <!-- Ground is a Gazebo dynamics surface at the existing z=0, not a PCD floor. -->
    <model name="ground_plane"><static>true</static><link name="link">
      <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry><surface><friction><ode><mu>1</mu><mu2>1</mu2></ode></friction></surface></collision>
      <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry><material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
    </link></model>
    <include><uri>model://fuel_official_office</uri><name>fuel_official_office</name><pose>0 0 0 0 0 0</pose></include>
    <gui fullscreen="0"><camera name="user_camera"><pose>16 -23 23 0 0.75 2.18</pose><view_controller>orbit</view_controller></camera></gui>
  </world>
</sdf>
