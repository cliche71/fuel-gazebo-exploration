<launch>
  <!-- Preview only. Do not run alongside an already running Gazebo server. -->
  <arg name="gui" default="true"/>
  <arg name="paused" default="false"/>
  <env name="GAZEBO_MODEL_PATH" value="$(find fuel_gazebo_official_world)/models:$(optenv GAZEBO_MODEL_PATH)"/>
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(find fuel_gazebo_official_world)/worlds/office.world"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="paused" value="$(arg paused)"/>
    <arg name="use_sim_time" value="true"/>
  </include>
</launch>
